            messagebox.showinfo("Export Complete", f"Saved OOS list to:\n{file_path}", parent=self)

        else:
            file_path = filedialog.asksaveasfilename(
                defaultextension=".csv",
                initialfile="Open_Purchase_Orders_Summary.csv",
                filetypes=[("CSV File", "*.csv")]
            )
            if not file_path:
                return

            with open(file_path, mode="w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
