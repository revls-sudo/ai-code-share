class BCService:
    @staticmethod
    def get_access_token():
        """Acquires OAuth2 Bearer token from Azure AD using client credentials."""
        token_url = f"https://login.microsoftonline.com/{BC_CONFIG['tenant_id']}/oauth2/v2.0/token"
        payload = {
            "grant_type": "client_credentials",
            "client_id": BC_CONFIG["client_id"],
            "client_secret": BC_CONFIG["client_secret"],
            "scope": "https://api.businesscentral.dynamics.com/.default"
        }
        try:
            resp = requests.post(token_url, data=payload, timeout=12)
            resp.raise_for_status()
            return resp.json().get("access_token")
        except Exception as e:
            raise RuntimeError(f"Authentication Failed: {e}")

    @classmethod
    def fetch_and_process_open_pos(cls, progress_callback=None):
        """
        Fetches open PO lines (outstandingQuantity > 0) and enriches them with SKU details.
        Calls progress_callback(message) at each milestone.
        """
        if progress_callback:
            progress_callback("Authenticating with Business Central...")
        token = cls.get_access_token()
        if not token:
            raise RuntimeError("Could not retrieve authorization token.")

        base_url = BC_CONFIG["base_url"].format(
            tenantId=BC_CONFIG["tenant_id"],
            companyId=BC_CONFIG["company_id"]
        )
        headers = {"Authorization": f"Bearer {token}"}

        # 1. Fetch raw open PO lines
        if progress_callback:
            progress_callback("Fetching open PO lines...")
        po_filter = "outstandingQuantity gt 0"
        po_endpoint = f"{base_url}/ph_purchase_order?$filter={quote(po_filter)}"
        
        response = requests.get(po_endpoint, headers=headers, timeout=20)
        response.raise_for_status()
        raw_po_lines = response.json().get("value", [])

        if not raw_po_lines:
            return []

        # 2. Extract unique SKUs
        unique_skus = list(set(line.get("Productcode") for line in raw_po_lines if line.get("Productcode")))
        sku_details_map = {}
        batch_size = 40
        total_batches = (len(unique_skus) + batch_size - 1) // batch_size

        # 3. Batch fetch SKU metadata (Brand, SOH, Description)
        for idx, i in enumerate(range(0, len(unique_skus), batch_size), start=1):
            if progress_callback:
                progress_callback(f"Fetching SKU stock info (Batch {idx}/{total_batches})...")
            
            batch_skus = unique_skus[i:i + batch_size]
            sku_filter_part = " or ".join([f"productcode eq '{sku}'" for sku in batch_skus])
            full_sku_filter = f"locationCode eq 'WH001' and ({sku_filter_part})"
            sku_endpoint = f"{base_url}/ph_sku?$filter={quote(full_sku_filter)}"

            sku_resp = requests.get(sku_endpoint, headers=headers, timeout=20)
            sku_resp.raise_for_status()
            sku_data = sku_resp.json().get("value", [])

            for item in sku_data:
                sku = item.get("productcode")
                if sku:
                    raw_brand = item.get("brand", "")
                    cleaned_brand = raw_brand.split('_', 1)[-1] if '_' in raw_brand else raw_brand
                    sku_details_map[sku] = {
                        'brand': cleaned_brand or "Unknown",
                        'description': item.get("description", ""),
                        'soh': item.get("Quantity", 0) or 0
                    }

        # 4. Group by (PO Number, Brand)
        if progress_callback:
            progress_callback("Aggregating purchase order lines...")

        po_brand_groups = {}
        for line in raw_po_lines:
            sku = line.get("Productcode")
            sku_details = sku_details_map.get(sku, {'brand': 'Unknown', 'description': '', 'soh': 0})
            brand = sku_details.get('brand', 'Unknown')
            doc_no = line.get('documentNo', 'UNKNOWN')
            group_key = (doc_no, brand)

            if group_key not in po_brand_groups:
                po_brand_groups[group_key] = {
                    'documentNo': doc_no,
                    'brand': brand,
                    'quantity': 0,
                    'ksshipmenttype': line.get('ksshipmenttype', '') or 'Standard',
                    'kslandingdate': line.get('kslandingdate'),
                    'ksdeliverydate': line.get('ksdeliverydate'),
                    'line_items': []
                }

            po_brand_groups[group_key]['quantity'] += line.get('quantity', 0)
            line_item = line.copy()
            line_item.update(sku_details)
            po_brand_groups[group_key]['line_items'].append(line_item)

        return list(po_brand_groups.values())


