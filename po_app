    def _create_kpi_card(self, parent, title, value, bg_color):
        card = ctk.CTkFrame(parent, corner_radius=18, fg_color=bg_color)
        lbl_title = ctk.CTkLabel(
            card, text=title.upper(),
            font=ctk.CTkFont(family="Segoe UI", size=10, weight="bold"),
            text_color="#E2E8F0"  # Soft white
        )
        lbl_title.pack(anchor="w", padx=14, pady=(8, 0))
        lbl_val = ctk.CTkLabel(
            card, text=value,
            font=ctk.CTkFont(family="Segoe UI", size=20, weight="bold"),
            text_color="#FFFFFF"  # Bold pure white
        )
        lbl_val.pack(anchor="w", padx=14, pady=(0, 8))
        card.value_label = lbl_val
        return card

