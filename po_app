    # ---------------- Asynchronous Data Fetching ----------------
    def start_async_data_load(self):
        self.btn_refresh.configure(state="disabled")
        self.status_label.configure(text="Connecting to Business Central...")

        for item in self.po_tree.get_children():
            self.po_tree.delete(item)
        self.po_tree.insert('', 'end', values=('Loading data, please wait...', '', '', '', '', ''))

        threading.Thread(target=self._worker_fetch_data, daemon=True).start()

    def _worker_fetch_data(self):
        def progress_handler(msg):
            self._msg_queue.put(("status", msg))

        try:
            data = BCService.fetch_and_process_open_pos(progress_callback=progress_handler)
            self._msg_queue.put(("data", data))
        except Exception as e:
            self._msg_queue.put(("error", str(e)))

    def _poll_queue(self):
        try:
            while True:
                msg_type, payload = self._msg_queue.get_nowait()
                if msg_type == "status":
                    self.status_label.configure(text=payload)
                elif msg_type == "data":
                    self._process_loaded_data(payload)
                    self.status_label.configure(text=f"Last updated: {datetime.datetime.now().strftime('%H:%M:%S')}")
                    self.btn_refresh.configure(state="normal")
                elif msg_type == "error":
                    self.btn_refresh.configure(state="normal")
                    self.status_label.configure(text="Failed to load data.")
                    messagebox.showerror("Error Fetching Data", payload, parent=self)
        except queue.Empty:
            pass
        finally:
            self.after(100, self._poll_queue)

    def _process_loaded_data(self, summary_list):
        self.all_summary_data = summary_list or []
        self.all_oos_items = []

        total_orders_qty = 0
        oos_zero_count = 0
        low_stock_count = 0
        overdue_or_this_week = 0

        today = datetime.date.today()
        start_of_week = today - datetime.timedelta(days=today.weekday())
        end_of_week = start_of_week + datetime.timedelta(days=6)

        for po in self.all_summary_data:
            total_orders_qty += po.get('quantity', 0)
            po['_parent_po'] = po

            # Formatted combined date
            del_str = self._format_date(po.get('ksdeliverydate'))
            eta_str = self._format_date(po.get('kslandingdate'))
            po['deliveryOrEta'] = del_str if del_str else (f"ETA: {eta_str}" if eta_str else "—")
            po['matched_skus'] = ""

            # Check Overdue / This week timeline
            d_raw = po.get('ksdeliverydate')
            if d_raw and '0001-01-01' not in str(d_raw):
                try:
                    dt = datetime.datetime.fromisoformat(str(d_raw)).date()
                    if dt <= end_of_week:
                        overdue_or_this_week += 1
                except Exception:
                    pass

            # Extrapolate Inbound OOS / Low Stock items strictly from open PO lines
            for line in po.get('line_items', []):
                soh = line.get('soh', 0)
                if soh < 50:
                    oos_entry = dict(line)
                    oos_entry['_parent_po'] = po
                    oos_entry['documentNo'] = po.get('documentNo')
                    oos_entry['brand'] = line.get('brand') or po.get('brand')
                    oos_entry['deliveryOrEta'] = po['deliveryOrEta']

                    if soh <= 0:
                        oos_entry['stock_status'] = "🔴 OUT OF STOCK (0)"
                        oos_zero_count += 1
                    else:
                        oos_entry['stock_status'] = f"🟡 LOW STOCK ({soh})"
                        low_stock_count += 1

                    self.all_oos_items.append(oos_entry)

        # Update KPI Cards
        self.card_total_pos.value_label.configure(text=f"{len(self.all_summary_data):,}")
        self.card_total_qty.value_label.configure(text=f"{total_orders_qty:,}")
        self.card_oos_count.value_label.configure(text=f"{oos_zero_count:,}")
        self.card_low_stock.value_label.configure(text=f"{low_stock_count:,}")
        self.card_overdue.value_label.configure(text=f"{overdue_or_this_week:,}")

        # Default sort
        self.all_summary_data.sort(key=self._get_default_sort_key)
        self.apply_po_filters()
        self.apply_oos_filters()

    # ---------------- Filtering Logic ----------------
    def apply_po_filters(self):
        query = self.po_search_entry.get().strip().lower()
        status_filter = self.status_filter_var.get()
        date_type_filter = self.date_type_var.get()

        self.filtered_po_data = []
        for item in self.all_summary_data:
            doc_no = str(item.get('documentNo', '')).lower()
            brand = str(item.get('brand', '')).lower()
            ship_type = str(item.get('ksshipmenttype', '')).lower()
            date_str = str(item.get('deliveryOrEta', '')).lower()

            # Deep Search: Check summary fields OR individual line items
            matched_summary = (query in doc_no or query in brand or query in ship_type or query in date_str)
            matching_line_skus = []
            if query:
                for line in item.get('line_items', []):
                    sku = str(line.get('Productcode', '')).lower()
                    desc = str(line.get('description', '')).lower()
                    if query in sku or query in desc:
                        matching_line_skus.append(line.get('Productcode', ''))

            if query and not (matched_summary or matching_line_skus):
                continue

            # Confirmed vs ETA filter
            del_raw = item.get('ksdeliverydate')
            eta_raw = item.get('kslandingdate')
            has_confirmed = bool(del_raw and '0001-01-01' not in str(del_raw))
            has_eta = bool(eta_raw and '0001-01-01' not in str(eta_raw))

            if date_type_filter == "Confirmed Delivery" and not has_confirmed:
                continue
            elif date_type_filter == "ETA Only" and (has_confirmed or not has_eta):
                continue

            # Date status timeline filter
            cat = self._get_status_category(item)
            if status_filter == "Overdue" and cat != "overdue":
                continue
            elif status_filter == "Due This Week" and cat != "this_week":
                continue
            elif status_filter == "Due Next Week" and cat != "next_week":
                continue
            elif status_filter == "Future / No Date" and cat != "future":
                continue

            display_item = dict(item)
            display_item['matched_skus'] = ", ".join(matching_line_skus[:4]) if matching_line_skus else ""
            self.filtered_po_data.append(display_item)

        self.populate_po_tree()

    def apply_oos_filters(self):
        query = self.oos_search_entry.get().strip().lower()
        sub_filter = self.oos_filter_var.get()

        self.filtered_oos_data = []
        for line in self.all_oos_items:
            sku = str(line.get('Productcode', '')).strip()

            # 1. Independent Components Check (Hides xxx-8xxx and xxx-9xxx)
            if not self.show_components and '-' in sku:
                after_dash = sku.split('-', 1)[-1]
                if after_dash.startswith(('8', '9')):
                    continue

            # 2. Text Search Check
            desc = str(line.get('description', '')).lower()
            brand = str(line.get('brand', '')).lower()
            doc_no = str(line.get('documentNo', '')).lower()

            if query and not (query in sku.lower() or query in desc or query in brand or query in doc_no):
                continue

            # 3. Stock Level Check
            soh = line.get('soh', 0)
            if sub_filter == "Out of Stock" and soh > 0:
                continue
            elif sub_filter == "Low Stock" and (soh <= 0 or soh >= 50):
                continue

            self.filtered_oos_data.append(line)

        self.populate_oos_tree()

        self.populate_oos_tree()

    def populate_po_tree(self):
        for item in self.po_tree.get_children():
            self.po_tree.delete(item)

        for i, summary in enumerate(self.filtered_po_data):
            cat = self._get_status_category(summary)
            tag = cat if cat in ['overdue', 'this_week', 'next_week'] else ''

            values = (
                summary.get('documentNo', ''),
                summary.get('brand', ''),
                f"{summary.get('quantity', 0):,}",
                summary.get('ksshipmenttype', ''),
                summary.get('deliveryOrEta', '—'),
                summary.get('matched_skus', '')
            )
            self.po_tree.insert('', 'end', iid=str(i), values=values, tags=(tag,) if tag else ())

        if self.active_tab == "po":
            self.row_count_label.configure(text=f"Showing {len(self.filtered_po_data)} of {len(self.all_summary_data)} Purchase Orders")

    def populate_oos_tree(self):
        for item in self.oos_tree.get_children():
            self.oos_tree.delete(item)

        for i, line in enumerate(self.filtered_oos_data):
            soh = line.get('soh', 0)
            tag = 'oos_zero' if soh <= 0 else 'low_stock'

            values = (
                line.get('Productcode', ''),
                line.get('description', ''),
                line.get('brand', ''),
                f"{soh:,}",
                f"{line.get('quantity', 0):,}",
                line.get('documentNo', ''),
                line.get('deliveryOrEta', '—'),
                line.get('stock_status', '')
            )
            self.oos_tree.insert('', 'end', iid=str(i), values=values, tags=(tag,))

        if self.active_tab == "oos":
            self.row_count_label.configure(text=f"Showing {len(self.filtered_oos_data)} of {len(self.all_oos_items)} Critical Inbound Items")

    # ---------------- Helpers & Sorting ----------------
    def _format_date(self, date_str):
        if not date_str or '0001-01-01' in str(date_str):
            return ""
        try:
            return datetime.datetime.fromisoformat(str(date_str)).strftime('%d/%m/%Y')
        except (ValueError, TypeError):
            return str(date_str)

    def _get_status_category(self, item):
        delivery_str = item.get('ksdeliverydate')
        if not delivery_str or '0001-01-01' in delivery_str:
            return 'future'
        try:
            delivery_date = datetime.datetime.fromisoformat(delivery_str).date()
            today = datetime.date.today()
            start_of_this_week = today - datetime.timedelta(days=today.weekday())
            end_of_this_week = start_of_this_week + datetime.timedelta(days=6)
            start_of_next_week = end_of_this_week + datetime.timedelta(days=1)
            end_of_next_week = start_of_next_week + datetime.timedelta(days=6)

            if delivery_date < start_of_this_week:
                return 'overdue'
            elif start_of_this_week <= delivery_date <= end_of_this_week:
                return 'this_week'
            elif start_of_next_week <= delivery_date <= end_of_next_week:
                return 'next_week'
            return 'future'
        except Exception:
            return 'future'

    def _get_default_sort_key(self, item):
        def safe_date(d_str):
            if not d_str or '0001-01-01' in str(d_str):
                return datetime.date(9999, 12, 31)
            try:
                return datetime.datetime.fromisoformat(str(d_str)).date()
            except Exception:
                return datetime.date(9999, 12, 31)

        delivery_date = safe_date(item.get('ksdeliverydate'))
        landing_date = safe_date(item.get('kslandingdate'))
        primary_date = delivery_date if delivery_date != datetime.date(9999, 12, 31) else landing_date
        return (primary_date, str(item.get('documentNo', '')))

    def sort_po_column(self, col_id):
        last_col, last_rev = self._sort_state["po"]
        reverse = (last_col == col_id and not last_rev)

        def key_func(item):
            if col_id == 'deliveryOrEta':
                return self._get_default_sort_key(item)
            elif col_id == 'quantity':
                return item.get('quantity', 0)
            val = item.get(col_id)
            return str(val).lower() if val is not None else ""

        self.filtered_po_data.sort(key=key_func, reverse=reverse)
        self._sort_state["po"] = (col_id, reverse)

        for c in self.po_columns.keys():
            txt = self.po_columns[c][0]
            if c == col_id:
                txt += " ▼" if reverse else " ▲"
            self.po_tree.heading(c, text=txt)

        self.populate_po_tree()

    def sort_oos_column(self, col_id):
        last_col, last_rev = self._sort_state["oos"]
        reverse = (last_col == col_id and not last_rev)

        def key_func(item):
            if col_id in ['soh', 'quantity']:
                return item.get(col_id, 0)
            val = item.get(col_id)
            return str(val).lower() if val is not None else ""

        self.filtered_oos_data.sort(key=key_func, reverse=reverse)
        self._sort_state["oos"] = (col_id, reverse)

        for c in self.oos_columns.keys():
            txt = self.oos_columns[c][0]
            if c == col_id:
                txt += " ▼" if reverse else " ▲"
            self.oos_tree.heading(c, text=txt)

        self.populate_oos_tree()

    def _refresh_segmented_styles(self, segmented_widget):
        """Applies bold white to the selected segment and regular muted slate to unselected segments."""
        current_val = segmented_widget.get()
        for val, btn in segmented_widget._buttons_dict.items():
            if val == current_val:
                btn.configure(
                    font=ctk.CTkFont(family="Segoe UI", size=12, weight="bold"),
                    text_color="#FFFFFF"
                )
            else:
                btn.configure(
                    font=ctk.CTkFont(family="Segoe UI", size=12, weight="normal"),
                    text_color="#64748B"  # Soft readable slate
                )

    def _on_oos_segment_changed(self):
        self._refresh_segmented_styles(self.oos_filter_segmented)
        self.apply_oos_filters()

