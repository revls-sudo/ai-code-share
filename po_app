    def export_to_csv(self):
        if self.detail_frame.winfo_ismapped() and self.current_detail_object:
            po = self.current_detail_object.get("documentNo", "PO")
            file_path = filedialog.asksaveasfilename(
                defaultextension=".csv",
                initialfile=f"PO_{po}_lines.csv",
                filetypes=[("CSV File", "*.csv")]
            )
            if not file_path:
                return

            with open(file_path, mode="w", newline="", encoding="utf-8") as f:
                writer = csv.writer(f)
                writer.writerow(["PO Number", "SKU", "Description", "Stock On Hand", "Ordered Quantity"])
                for item in self.current_detail_object.get("line_items", []):
                    writer.writerow([
                        po, item.get("Productcode", ""), item.get("description", ""),
                        item.get("soh", 0), item.get("quantity", 0)
                    ])
            messagebox.showinfo("Export Complete", f"Saved details to:\n{file_path}", parent=self)

        elif self.active_tab == "oos":
            file_path = filedialog.asksaveasfilename(
                defaultextension=".csv",
